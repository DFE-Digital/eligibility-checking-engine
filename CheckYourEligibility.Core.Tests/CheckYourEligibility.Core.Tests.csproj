<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>CheckYourEligibility.Core.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentAssertions" Version="8.11.0" />
		<PackageReference Include="AutoFixture" Version="4.18.1" />
		<PackageReference Include="AutoFixture.AutoMoq" Version="4.18.1" />
		<PackageReference Include="AutoFixture.Idioms" Version="4.18.1" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="NUnit" Version="5.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
		<PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageReference Include="Moq" Version="4.21.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CheckYourEligibility.Core\CheckYourEligibility.Core.csproj" />
	</ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
	
    <ItemGroup>
        <EmbeddedResource Include="Resources\HMRCManualEligibilityEvent.xlsm" />
        <EmbeddedResource Include="Resources\HMRCManualEligibilityEvent_invalid.xlsm" />
        <EmbeddedResource Include="Resources\HMRCManualEligibilityEvent_empty.xlsm" />
		<EmbeddedResource Include="Resources\HMRCManualEligibilityEvent_NoStyleOnEligibilityCodes.xlsm" />
    </ItemGroup>
	
    <ItemGroup>
      <Compile Update="Properties\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>


</Project>
